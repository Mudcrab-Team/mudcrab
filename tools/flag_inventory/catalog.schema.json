{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skyrim flag catalog v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "container",
      "bit",
      "name",
      "meaning",
      "source",
      "group"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "container": {
        "type": "string",
        "minLength": 1
      },
      "bit": {
        "type": [
          "integer",
          "string"
        ]
      },
      "name": {
        "type": "string"
      },
      "meaning": {
        "type": "string"
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "group": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
