    "local_direction": "r=-f32(fSunDirXExtreme/fSunXExtreme); raw=[f32(r*x),f32(fSunYExtreme*r),fSunZExtreme]; normalize by sqrt(f32(f32(x*x+y*y)+z*z)), reciprocal then three component multiplies.",
