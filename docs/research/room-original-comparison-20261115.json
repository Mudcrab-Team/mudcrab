  "findings": [
    {
      "pose": "BleakFallsBarrow01-room1-c",
      "observation": "The distant timber hall is absent in Skyrim and Mudcrab with culling, and present in the Mudcrab full-render control. Smaller geometry and effects differ; this is not an object-level parity pass."
    },
    {
      "pose": "BleakFallsBarrow01-joined-slave-walk",
      "observation": "The joined-room cave corridor and slanted stone support remain visible. Mudcrab culling and full rendering have no persistent pixel differences at this pose. Water and lighting differ from Skyrim."
    },
    {
      "pose": "GallowsRock01-outside-away",
      "observation": "Skyrim and culled Mudcrab omit the broad backside shell. Both retain the small arch at the right edge. Mudcrab retains extra plants and clutter."
    },
    {
      "pose": "GallowsRock01-inside-out",
      "observation": "Skyrim and culled Mudcrab retain the near overhead shell and right arch, while omitting the farther shell shown by the Mudcrab full-render control. Smaller objects and effects still differ."
    }
  ],
